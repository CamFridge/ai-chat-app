<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 用户可填写任意 OpenAI 兼容端点（含局域网 http 服务），因此允许明文流量 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
